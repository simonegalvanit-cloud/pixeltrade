# Copy this file to .env.local for running on your own computer, and fill in
# the values. On Vercel, add the same names under Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only.
SUPABASE_SECRET_KEY=
# Any long random string (at least 32 characters). Signs the sign-in cookie.
SESSION_SECRET=
