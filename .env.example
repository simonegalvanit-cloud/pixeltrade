# Copy this file to .env.local for running on your own computer, and fill in
# the values. On Vercel, add the same names under Settings → Environment Variables.
# Never commit real values.

# Privy (login + wallets). The App ID is public; the code has it built in.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy → Configuration → App settings → API keys → App secret. Server only (Sensitive).
PRIVY_APP_SECRET=

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server only (Sensitive).
SUPABASE_SECRET_KEY=
